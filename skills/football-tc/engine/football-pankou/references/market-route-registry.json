    "market_direction_replaces_model": true,
    "formal_activation": "blocked_pending_rolling_oos_and_price_audit"
  },
  "hhad": {
    "required_exact_signed_line": true,
    "required_direct_three_way_quote": true,
    "ordinary_wdl_translation": "forbidden",
    "asian_line_translation": "forbidden",
    "default_status": "blocked_unless_direct_market_quote_present"
  },
  "o25": {
    "family": "api_football.fixed_2_5",
    "line": 2.5,
    "outcomes": [
      "OVER",
      "UNDER"
    ],
    "input_basis": "frozen_precomputed_devigged_probability",
    "aggregation": "collector_selected_value_authoritative",
    "independent_head": true,
    "role": "external_analysis_only",
    "official_playable": false,
    "public_display": false,
    "priority_selection_eligible": false,
    "formal_activation": "blocked_pending_rolling_oos_and_price_audit"
  },
  "btts": {
